{
  "name": "sg-makan-deals-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute makan-deals --remote --file=schema.sql",
    "build:test": "wrangler deploy --dry-run --outdir dist",
