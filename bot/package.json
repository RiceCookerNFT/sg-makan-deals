    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "miniflare": "^4.20260730.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.151.3"
  }
}
